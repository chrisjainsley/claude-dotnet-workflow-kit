diff --git a/src/Orders/Application/CancelOrderHandler.cs b/src/Orders/Application/CancelOrderHandler.cs
index 1111111..2222222 100644
--- a/src/Orders/Application/CancelOrderHandler.cs
+++ b/src/Orders/Application/CancelOrderHandler.cs
@@ -10,6 +10,14 @@ public sealed class CancelOrderHandler
     public CancelOrderHandler(IOrderRepository orders) => _orders = orders;
 
+    public async Task<Result> HandleAsync(CancelOrder command)
+    {
+        var order = await _orders.GetAsync(command.OrderId);
+        order.Cancel(DateTime.Now);
+        await _orders.SaveAsync(order);
+        return Result.Ok();
+    }
+
     private readonly IOrderRepository _orders;
 }
